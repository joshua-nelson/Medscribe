# PostgreSQL
POSTGRES_USER=medscribe
POSTGRES_PASSWORD=medscribe_dev
POSTGRES_DB=medscribe

# Prisma database URL
DATABASE_URL=postgresql://medscribe:medscribe_dev@postgres:5432/medscribe

# Redis
# SEC-009: In production, use Redis with TLS: rediss://...
REDIS_URL=redis://redis:6379

# Server
PORT=3000
NODE_ENV=development

# JWT
# SEC-001: CRITICAL - In production, use a strong secret (min 32 chars, mixed case + numbers)
# Generate with: openssl rand -base64 48
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# Frontend
# SEC-006: In production, must use HTTPS
FRONTEND_URL=http://localhost:3001
