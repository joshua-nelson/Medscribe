# PostgreSQL
POSTGRES_USER=medscribe
POSTGRES_PASSWORD=medscribe_dev
POSTGRES_DB=medscribe

# Prisma database URL
DATABASE_URL=postgresql://medscribe:medscribe_dev@postgres:5432/medscribe

# Redis
REDIS_URL=redis://redis:6379

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# Frontend
FRONTEND_URL=http://localhost:3001

# Live transcription tuning
STREAM_BUFFER_MS=3000
STREAM_BUFFER_MS_MIN=1200
STREAM_BUFFER_MS_MAX=3000
STREAM_OVERLAP_MS=1200
STREAM_STABILITY_MS=900
TRANSCRIPTION_METRICS_ENABLED=true

# ASR transport tuning
ASR_ENABLE_BASE64_FALLBACK=true
ASR_REQUEST_TIMEOUT_MS=15000
ASR_REQUEST_RETRIES=1

# ASR engine + model tuning
ASR_ENGINE=openai_whisper
ASR_COMPUTE_TYPE=int8
WHISPER_MODEL_LIVE=base.en
WHISPER_MODEL_FINAL=small
ASR_MAX_INFLIGHT=2
ASR_QUEUE_MAX=4
ASR_QUEUE_TIMEOUT_MS=2500

# Diarization service (Phase 4.1)
HUGGINGFACE_HUB_TOKEN=
DIARIZATION_URL=http://diarization:8500
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cpu
DIARIZATION_REQUEST_TIMEOUT_MS=20000
DIARIZATION_REQUEST_RETRIES=1
DIARIZATION_MAX_INFLIGHT=1
DIARIZATION_QUEUE_MAX=2
DIARIZATION_QUEUE_TIMEOUT_MS=5000
