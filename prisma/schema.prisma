generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Provider {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  email         String   @unique @map("email")
  passwordHash  String   @map("password_hash")
  name          String   @map("name")
  specialty     String?  @map("specialty")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  encounters    Encounter[]

  @@map("providers")
}

model Encounter {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  providerId    String   @map("provider_id") @db.Uuid
  patientName   String?  @map("patient_name")
  speakerAssignments Json? @map("speaker_assignments")
  status        String   @default("recording") @map("status")
  startedAt     DateTime @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  audioFilePath String?  @map("audio_file_path")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  provider      Provider @relation(fields: [providerId], references: [id])
  transcripts   Transcript[]

  @@map("encounters")
}

model Transcript {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  encounterId  String   @map("encounter_id") @db.Uuid
  fullText     String?  @map("full_text")
  segments     Json?    @map("segments")
  speakerCorrections Json? @map("speaker_corrections")
  audioFilePath String? @map("audio_file_path")
  createdAt    DateTime @default(now()) @map("created_at")

  encounter    Encounter @relation(fields: [encounterId], references: [id])

  @@map("transcripts")
}
